# Majburiy
TELEGRAM_TOKEN=
ADMIN_ID=

# Cobalt server (ixtiyoriy, standart qiymat bilan ishlaydi)
COBALT_API_URL=http://178.128.199.137:9000/
COBALT_API_KEY=
# Cobalt cookies.json — Instagram cookie'lari shu yerdan ham olinadi (story, musiqa, sifat uchun)
COBALT_COOKIES_PATH=/root/cobalt/cookies.json

# Instagram cookie qatori (cookies.json o'rniga). Masalan:
# INSTAGRAM_COOKIE=sessionid=...; csrftoken=...; ds_user_id=...
INSTAGRAM_COOKIE=

# yt-dlp uchun Netscape formatidagi cookie fayllar (ixtiyoriy).
# Yoki shunchaki cookies/youtube.txt, cookies/instagram.txt fayllarini qo'ying.
YOUTUBE_COOKIES_FILE=
INSTAGRAM_COOKIES_FILE=
TIKTOK_COOKIES_FILE=
PINTEREST_COOKIES_FILE=

# YouTube sozlamalari
YOUTUBE_PLAYER_CLIENTS=default,mweb
# bgutil PO token serveri boshqa manzilda bo'lsa (standart: http://127.0.0.1:4416)
YOUTUBE_POT_URL=

# Bir vaqtda nechta yuklash bajarilsin
MAX_CONCURRENT_JOBS=4

# Lokal Telegram Bot API server (2GB gacha fayllar), ixtiyoriy
TELEGRAM_API_URL=

# Qo'shimcha: o'z yt-dlp / ffmpeg yo'li, proxy
YTDLP_PATH=
FFMPEG_PATH=
YTDLP_PROXY=
YTDLP_EXTRA_ARGS=
